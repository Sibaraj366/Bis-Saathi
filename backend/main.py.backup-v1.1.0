# FASTAPI APPLICATION
# ============================================================

app = FastAPI(
    title="BIS Saathi API",
    description=(
        "Backend API for the BIS Saathi "
        "AI assistant"
    ),
    version="1.1.0",
)


# ============================================================
# REQUEST MODELS
# ============================================================

class ChatRequest(BaseModel):

    message: str

    language: str = "English"


class ComplianceRequest(BaseModel):

    product: str

    language: str = "English"


class DocumentQuestionRequest(BaseModel):

    document_id: str

    question: str

    language: str = "English"


# ============================================================
# CORS
# ============================================================

app.add_middleware(
    CORSMiddleware,

    allow_origins=["*"],

    allow_credentials=True,

    allow_methods=["*"],

    allow_headers=["*"],
)


